# Railway
# Add the real token only in Railway Variables; never commit it.
RAILWAY_API_TOKEN=

# Railway automatically provides these IDs at runtime.
# RAILWAY_PROJECT_ID
# RAILWAY_ENVIRONMENT_ID
# RAILWAY_SERVICE_ID

# Internal ports
PORT=
REALITY_PORT=2053
XHTTP_BACKEND_PORT=10001
GRPC_BACKEND_PORT=10002

# Xray
UUID=
REALITY_SNI=www.apple.com
REALITY_TARGET=www.apple.com:443
REALITY_SHORT_ID=

# Exactly 8 alphanumeric characters. Leave empty to generate at startup.
TLS_PATH=

# Railway HTTPS edge terminates public TLS, so TLS SNI is the Railway service domain.
# Do not set this to www.microsoft.com on Railway.
TLS_SNI=

LOG_LEVEL=warning
